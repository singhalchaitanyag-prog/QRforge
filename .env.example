# Copy this file to .env for local use (it is git-ignored). On a host, set these as environment variables instead.

# --- Turso (free hosted database). Leave both empty to use a local file instead. ---
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# --- Required with Turso. A long random string. Never change it: it encrypts two-step verification secrets. ---
APP_SECRET=replace-with-a-long-random-string

# --- Production settings ---
PORT=3000
BASE_URL=https://qr.example.com
COOKIE_SECURE=1
TRUST_PROXY=1
